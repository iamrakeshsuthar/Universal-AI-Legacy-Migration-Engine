# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is git-ignored — never commit real API keys.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Streamlit reads secrets.toml from <project-root>/.streamlit/secrets.toml
# when the app is launched from the project root (as the devcontainer does:
# `streamlit run app/app.py`).

# Which provider app.py routes AI calls to: "Claude" or "Gemini"
# Defaults to "Gemini" in app.py if this key is omitted entirely.
AI_PROVIDER = "Gemini"

# Required if AI_PROVIDER = "Claude"
ANTHROPIC_API_KEY = "sk-ant-..."

# Required if AI_PROVIDER = "Gemini"
GOOGLE_API_KEY = "..."
